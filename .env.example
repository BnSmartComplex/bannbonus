# Configuration template only. Never commit real secrets.
# NEXT_PUBLIC_APP_URL=https://your-verified-domain.example
# Public browser configuration; values remain unset until explicitly provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # server-only; do not expose to browser
# LINE_CHANNEL_SECRET=        # server-only, not yet connected
# LINE_CHANNEL_ACCESS_TOKEN=  # server-only, not yet connected

# Chang24 office -> customer road route: OpenStreetMap / openrouteservice.
# Set in Vercel as SERVER-ONLY encrypted secret; restrict usage/quota on provider account.
# Without this key the detailed map can display, but no verified driving route or price is available.
OPENROUTESERVICE_API_KEY=

# Approved Chang24 extra road tariff is part of src/modules/booking/service-policy.ts
# Owner confirmed 10 THB/km over first 5 km, ceil extra road km to next whole kilometre.
# No additional environment variables are required for this tariff.
