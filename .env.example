# Configuration template only. Never commit real secrets.
# NEXT_PUBLIC_APP_URL=https://your-verified-domain.example
# Public browser configuration; values remain unset until explicitly provisioned.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # server-only; do not expose to browser
# LINE_CHANNEL_SECRET=        # server-only, not yet connected
# LINE_CHANNEL_ACCESS_TOKEN=  # server-only, not yet connected

# Chang24 office -> customer road routing (SERVER ONLY, not NEXT_PUBLIC_)
# Only enable after owner approval of Routes API billing and usage quotas.
GOOGLE_ROUTES_API_KEY=
# Set only to a Maps Platform Place ID verified against the owner's office pin; otherwise server geocodes office address.
DAY_NERAMIT_VERIFIED_PLACE_ID=

# Chang24 extra road distance charge: requires BOTH owner-approved values.
# Prior proposed 10 THB/km is NOT an approved default.
# CHANG24_APPROVED_EXTRA_BAHT_PER_KM=   # integer THB per extra km
# CHANG24_APPROVED_EXTRA_ROUNDING=      # PRO_RATA or CEIL_KILOMETRE
